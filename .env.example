# Set the key for the provider your MODEL uses.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# claude-* models use Anthropic. gemini-* and gemma-* models use Google.
MODEL=gemini-flash-lite-latest
DATABASE_PATH=data/paisalens.db
SQL_ROW_LIMIT=500
SQL_TIMEOUT_SECONDS=5
AGENT_MAX_STEPS=8
RATE_LIMIT_PER_MINUTE=5
DAILY_QUESTION_LIMIT=200
MAX_CONCURRENT_QUESTIONS=4
# Public deployments only: per-visitor temporary uploads. Never combine with ENABLE_UPLOADS.
PRIVATE_UPLOADS=false
SESSION_TTL_MINUTES=120
# Pin "today" for demos on static data. Leave empty to use the real date.
AS_OF_DATE=
